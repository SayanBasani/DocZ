generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id String @id @default(cuid())

  email String @unique @db.VarChar(255)

  username String @unique @db.VarChar(50)

  password String

  passwordChangedAt DateTime?

  role UserRole @default(USER)

  status UserStatus @default(PENDING)

  emailVerified Boolean @default(false)

  lastLogin DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  profile UserProfile?

  refreshTokens RefreshToken[]

  emailVerificationTokens EmailVerificationToken[]

  passwordResetTokens PasswordResetToken[]

  documents Document[]

  auditLogs AuditLog[]
  cases Case[]
}

model UserProfile {
  id String @id @default(cuid())

  userId String @unique

  firstName String? @db.VarChar(100)

  lastName String? @db.VarChar(100)

  phone String? @db.VarChar(20)

  avatar String?

  avatarPublicId String?

  country String? @db.VarChar(100)

  state String? @db.VarChar(100)

  city String? @db.VarChar(100)

  timezone String? @db.VarChar(100)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id String @id @default(cuid())

  tokenHash String? @unique

  userId String

  deviceId String?

  deviceName String?

  ipAddress String?

  userAgent String?

  expiresAt DateTime

  createdAt DateTime @default(now())

  lastUsedAt DateTime?

  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String

  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String

  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ================================
// Document Management
// ================================

enum DocumentType {
  LEGAL_DOCUMENT
  INVESTIGATION_REPORT
  WITNESS_STATEMENT
  EVIDENCE
  CORRESPONDENCE
  OTHER
}

enum DocumentStatus {
  UPLOADING
  ACTIVE
  ARCHIVED
  DELETED
}

enum AuditAction {
  DOCUMENT_UPLOADED
  DOCUMENT_ACCESSED
  DOCUMENT_DOWNLOADED
  DOCUMENT_UPDATED
  DOCUMENT_ARCHIVED
  DOCUMENT_DELETED
  DOCUMENT_PREVIEWED
  DOCUMENT_SHARED
  DOCUMENT_PERMISSION_REQUESTED
  DOCUMENT_PERMISSION_GRANTED
  DOCUMENT_PERMISSION_DENIED
  DOCUMENT_INTEGRITY_CHECKED
  OCR_STARTED
  OCR_COMPLETED
  OCR_FAILED
  FILE_ENCRYPTED
  FILE_DECRYPTED
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  ROLE_CHANGED
  PERMISSION_CHANGED
  SEARCH_PERFORMED
}

model Document {
  id String @id @default(cuid())

  userId String

  name String @db.VarChar(255)
  originalName String @db.VarChar(255)
  storedName String @db.VarChar(255)

  mimeType String @db.VarChar(150)
  extension String? @db.VarChar(20)

  size BigInt

  storagePath String @db.VarChar(1000)

  sha256 String @db.Char(64)

  category String? @db.VarChar(100)

  caseReference String? @db.VarChar(100)

  description String? @db.Text

  status DocumentStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  documentTags DocumentTag[]

  caseId String?

  case Case? @relation(
    fields: [caseId],
    references: [id],
    onDelete: SetNull
  )

  @@index([caseId])

  @@index([userId])
  @@index([category])
  @@index([caseReference])
  @@index([status])
  @@index([createdAt])
}

model DocumentTag {
  id String @id @default(cuid())

  documentId String

  name String @db.VarChar(50)

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, name])
  @@index([name])
}

model AuditLog {
  id String @id @default(cuid())

  userId String

  documentId String?

  action AuditAction

  ipAddress String? @db.VarChar(100)

  userAgent String? @db.Text

  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([documentId])
  @@index([action])
  @@index([createdAt])
}

// Case Details

enum CaseStatus {
  OPEN
  CLOSED
  ARCHIVED
}
model Case {
  id String @id @default(cuid())

  userId String

  reference String @db.VarChar(100)
  title String @db.VarChar(255)
  description String? @db.Text

  status CaseStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  documents Document[]

  @@unique([userId, reference])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}